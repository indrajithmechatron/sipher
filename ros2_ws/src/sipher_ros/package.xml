<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sipher_ros</name>
  <version>0.1.0</version>
  <description>
    Native ROS 2 driver/control/diagnostics for the Sipher quadruped.
    Owns the Pico serial port and replaces pico_bridge during migration.
  </description>
  <maintainer email="indrajithmechatron@gmail.com">indrajithmechatron</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>sipher_msgs</depend>

  <exec_depend>python3-serial</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
