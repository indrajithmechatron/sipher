<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sipher_hardware</name>
  <version>0.1.0</version>
  <description>
    ros2_control SystemInterface for the Sipher quadruped: bridges
    controller_manager to the sipher_driver serial bridge over ROS topics
    (read from /sensors, write to /servo_cmds). Serial stays single-owner.
  </description>
  <maintainer email="indrajithmechatron@gmail.com">indrajithmechatron</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>sipher_msgs</depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
